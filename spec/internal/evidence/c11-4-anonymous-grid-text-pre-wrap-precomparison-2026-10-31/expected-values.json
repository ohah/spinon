      "id": "pre-wrap-tab-max-content",
      "whiteSpace": "pre-wrap",
      "source": "XX\tXX",
      "tabSizeSpaces": 8,
      "expectedColumnsCssPx": [100],
      "expectedRowsCssPx": [10],
      "expectedRootBorderBoxCssPx": [100, 10]
    },
