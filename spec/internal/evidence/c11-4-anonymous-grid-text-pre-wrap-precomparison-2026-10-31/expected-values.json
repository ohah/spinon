    "sections": ["CSS Text Level 3 §3", "CSS Grid Layout Level 1 §6", "CSS Grid Layout Level 1 §11.5.1"],
    "status": "Candidate Recommendation Draft"
  },
  "font": {
    "path": "tests/fixtures/resources/c15/Ahem.ttf",
    "sha256": "b719ecb31c5b21fc573c03f6421c74ac63c271a5a3ff841e34f9705fb94b8448",
    "fontSizeCssPx": 10,
    "lineHeightCssPx": 10,
    "advancePerAhemGlyphOrSpaceCssPx": 10
  },
  "scenes": [
    {
      "id": "normal-max-content",
      "whiteSpace": "normal",
      "source": "XX  XX",
      "expectedColumnsCssPx": [50],
      "expectedRowsCssPx": [10],
      "expectedRootBorderBoxCssPx": [50, 10]
    },
    {
      "id": "pre-wrap-max-content",
      "whiteSpace": "pre-wrap",
      "source": "XX  XX",
      "expectedColumnsCssPx": [60],
      "expectedRowsCssPx": [10],
      "expectedRootBorderBoxCssPx": [60, 10]
    },
    {
      "id": "pre-wrap-comment-split-max-content",
      "whiteSpace": "pre-wrap",
      "sourceTextSegments": ["XX ", " XX"],
      "combinedText": "XX  XX",
      "expectedColumnsCssPx": [60],
      "expectedRowsCssPx": [10],
      "expectedRootBorderBoxCssPx": [60, 10],
      "expectedAnonymousGridItemCount": 1
    },
    {
      "id": "pre-wrap-wrap",
      "whiteSpace": "pre-wrap",
      "source": "XX XX",
      "definiteRootWidthCssPx": 25,
      "expectedColumnsCssPx": [25],
      "expectedRowsCssPx": [20],
      "expectedRootBorderBoxCssPx": [25, 20]
    },
    {
      "id": "pre-wrap-forced-break-max-content",
      "whiteSpace": "pre-wrap",
      "source": "XX\nXX",
      "expectedColumnsCssPx": [20],
      "expectedRowsCssPx": [20],
      "expectedRootBorderBoxCssPx": [20, 20]
    },
    {
      "id": "normal-min-content",
      "whiteSpace": "normal",
      "source": "XX  XX",
      "expectedColumnsCssPx": [20],
      "expectedRowsCssPx": [20],
      "expectedRootBorderBoxCssPx": [20, 20]
    },
    {
      "id": "pre-wrap-min-content",
      "whiteSpace": "pre-wrap",
      "source": "XX  XX",
      "expectedColumnsCssPx": [20],
      "expectedRowsCssPx": [20],
      "expectedRootBorderBoxCssPx": [20, 20]
    },
    {
      "id": "pre-wrap-whitespace-only-item",
      "whiteSpace": "pre-wrap",
      "source": "  ",
      "expectedColumnsCssPx": [0],
      "expectedRowsCssPx": [0],
      "expectedRootBorderBoxCssPx": [0, 0],
      "expectedRenderedAnonymousGridItem": false
    },
    {
      "id": "pre-wrap-leading-spaces-max-content",
      "whiteSpace": "pre-wrap",
      "source": "  XX",
      "expectedColumnsCssPx": [40],
      "expectedRowsCssPx": [10],
      "expectedRootBorderBoxCssPx": [40, 10]
    },
    {
      "id": "pre-wrap-trailing-spaces-max-content",
      "whiteSpace": "pre-wrap",
      "source": "XX  ",
