{
  "name": "spinon-docs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/docs"
  ],
  "scripts": {
    "docs:dev": "bun run --filter @spinon/docs docs:dev",
    "docs:build": "bun run --filter @spinon/docs docs:build",
    "docs:preview": "bun run --filter @spinon/docs docs:preview",
    "bundle:bootstrap": "mkdir -p build/spinon/bootstrap && bun build examples/bootstrap/app.js --target=browser --outfile build/spinon/bootstrap/app.js",
    "test:js": "cd examples/bootstrap && bun test",
    "test:css-reference": "node --test tools/css-reference/*.test.mjs",
    "test:c04-queue": "bash tools/c04-queue/run-tests.sh",
    "css:reference:c01-property-surface": "node tools/css-reference/capture-property-surface.mjs",
    "css:reference:c04-flex-alignment": "node tools/css-reference/capture-c04-flex-alignment.mjs",
    "css:reference:c04-margin-layout": "node tools/css-reference/capture-c04-margin-layout.mjs",
    "css:reference:c04-margin-logical-shorthand": "node tools/css-reference/capture-c04-margin-logical-shorthand.mjs",
    "css:reference:c04-cascade-layers": "node tools/css-reference/capture-c04-cascade-layers.mjs",
    "css:reference:c04-media-environment": "node tools/css-reference/capture-c04-media-environment.mjs",
    "css:reference:c04-runtime-css-to-gpu": "node tools/css-reference/capture-runtime-css-to-gpu.mjs",
    "css:reference:c04-runtime-css-to-gpu-resize": "node tools/css-reference/capture-runtime-css-to-gpu-resize.mjs",
    "css:reference:c05-registered-properties": "node tools/css-reference/capture-c05-runtime-registered-properties.mjs",
    "css:reference:c07-1-min-max-sizing": "node tools/css-reference/capture-c07-min-max-sizing.mjs",
    "css:reference:c08-block-flow": "node tools/css-reference/capture-c08-block-flow.mjs",
    "css:verify:c05-registered-properties-multi-root": "node tools/css-reference/verify-c05-runtime-registered-properties-multi-root.mjs",
    "css:verify:c05-result-cache-precomparison": "node tools/css-reference/verify-c05-runtime-result-cache-precomparison.mjs",
    "css:verify:c05-incremental-restyle-precomparison": "node tools/css-reference/verify-c05-runtime-incremental-restyle-precomparison.mjs",
    "css:reference:s04": "node tools/css-reference/capture-s04-flex-paint.mjs",
    "css:reference:s04-y": "node tools/css-reference/capture-s04-flex-paint.mjs --fixture=asymmetric-y",
    "css:reference:s04-hit-test": "node tools/css-reference/capture-s04-flex-paint.mjs --fixture=asymmetric-y-hit-test",
    "test:rust": "cargo test --locked --workspace",
    "test:benchmark:r05-physical-touch": "node --test tools/benchmark/capture-android-physical-touch.test.mjs tools/benchmark/analyze-android-physical-touch-join.test.mjs",
    "test": "bun run test:js && bun run test:css-reference && bun run test:benchmark:r05-physical-touch && cargo test --locked --workspace",
    "verify:r06-priority:simulators": "bash tools/verify-r06-priority-simulators.sh",
    "verify:r06-priority:fairness:android": "bash tools/verify-r06-priority-fairness-android.sh",
    "verify:r06-priority:fairness:simulators": "bash tools/verify-r06-priority-fairness-simulators.sh",
    "verify:s03-dom-lifecycle:simulators": "bash tools/verify-s03-dom-lifecycle-simulators.sh",
    "verify:s03-shutdown:simulators": "bash tools/verify-s03-shutdown-simulators.sh",
    "benchmark:r05-trace-overhead:android": "bash tools/benchmark/run-android-trace-overhead-matrix.sh",
    "benchmark:r05:physical-touch:android": "node tools/benchmark/capture-android-physical-touch.mjs",
    "analyze:r05:physical-touch-android": "node tools/benchmark/analyze-android-physical-touch-join.mjs",
    "benchmark:r05-trace-overhead:ios": "bash tools/benchmark/run-ios-trace-overhead-matrix.sh",
    "build:android": "bash tools/build-android-app.sh",
    "build:ios-sim": "bash tools/build-ios-sim.sh"
  }
}
